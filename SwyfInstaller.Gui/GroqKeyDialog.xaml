<Window x:Class="SwyfInstaller.Gui.GroqKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Groq" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Paste your Groq API key. The installer validates it, saves it into FlagshipRouter, and points the mod at groq/openai/gpt-oss-120b."
                   TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock Margin="0,0,0,8">
            <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Link_RequestNavigate">Get a free key at console.groq.com/keys</Hyperlink>
        </TextBlock>
        <PasswordBox x:Name="KeyBox" Margin="0,0,0,8" />
        <TextBlock Text="Dashboard password (only if you changed it from 123456):" Margin="0,0,0,4" />
        <PasswordBox x:Name="DashboardBox" Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="#e57373" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; set up" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
